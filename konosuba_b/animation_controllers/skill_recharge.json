{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.skill_recharge":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"cd":"query.scoreboard('charge') < 0"},
						{"recharge":"query.scoreboard('mana') < 0"}
					]
				},
				"cd": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/scoreboard players add @s charge 1"
					]
				},
				"recharge": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/particle minecraft:end_chest ~ ~0.5 ~",
						"/scoreboard players add @s mana 1"
					]
				}
			}
		}
 	}
 }