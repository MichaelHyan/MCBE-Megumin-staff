{
	"format_version": "1.8.0",
	"animation_controllers": {
		"controller.animation.skill":{
			"states":{
				"base_jeta":{
					"transitions":[
						{"staff":"query.get_equipped_item_name=='staff' && query.is_using_item && query.scoreboard('mana') >= 0"},
						{"staff_a":"query.get_equipped_item_name=='staff_a' && query.is_using_item && query.scoreboard('mana') >= 0"},
						{"drain_touch_a":"query.get_equipped_item_name=='drain_touch' && query.is_using_item && query.scoreboard('drain') == 0 && query.scoreboard('health') < 100"},
						{"drain_touch_b":"query.get_equipped_item_name=='drain_touch' && query.is_using_item && query.scoreboard('drain') == 0 && query.scoreboard('health') >= 100"},
						{"drain_touch_c":"query.get_equipped_item_name=='drain_touch' && query.is_using_item && query.scoreboard('drain') == 1 && query.scoreboard('health') > 0"},
						{"drain_touch_d":"query.get_equipped_item_name=='drain_touch' && query.is_using_item && query.scoreboard('drain') == 1 && query.scoreboard('health') == 0"},
						{"drain_touch_e":"query.get_equipped_item_name=='drain_touch' && variable.attack_time && query.scoreboard('drain') == 0 && query.scoreboard('charge') >= 0"},
						{"drain_touch_f":"query.get_equipped_item_name=='drain_touch' && variable.attack_time && query.scoreboard('drain') == 1 && query.scoreboard('charge') >= 0"}
					]
				},
				"staff": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/scoreboard objectives add mana dummy",
						"/summon entity:explosion_summon",
						"/music play spellb 1",
						"/scoreboard players add @s mana -100"
					]
				},
				"staff_a": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/scoreboard objectives add mana dummy",
						"/summon entity:exocism_a",
						"/scoreboard players add @s mana -100"
					]
				},
				"drain_touch_a": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/scoreboard objectives add health dummy",
						"/scoreboard objectives add charge dummy",
						"/scoreboard objectives add drain dummy",
						"/damage @n[rm=1,r=5,type=!item,type=!arrow,type=!armor_stand] 1",
						"/scoreboard players add @s health 1"
					]
				},
				"drain_touch_b": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/damage @n[rm=1,r=5,type=!item,type=!arrow,type=!armor_stand] 1",
						"/effect @s instant_health 1 1 true"
					]
				},
				"drain_touch_c": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/scoreboard players add @s health -1",
						"/effect @n[rm=1,r=5,type=!item,type=!arrow,type=!armor_stand] instant_health 1 1 true"
					]
				},
				"drain_touch_d": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/damage @s 1",
						"/effect @n[rm=1,r=5,type=!item,type=!arrow,type=!armor_stand] instant_health 1 1 true"
					]
				},
				"drain_touch_e": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/scoreboard players set @s drain 1",
						"/scoreboard players set @s charge -5"
					]
				},
				"drain_touch_f": {
					"transitions": [
							{
								"base_jeta": "(1.0)"
							}
					],
					"on_entry": [
						"/scoreboard players set @s drain 0",
						"/scoreboard players set @s charge -5"
					]
				}
			}
		}
 	}
 }